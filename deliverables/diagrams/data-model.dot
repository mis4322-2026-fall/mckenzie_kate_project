digraph G {
 graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.30", ranksep="0.42", fontname="DejaVu Sans", fontsize=20, labelloc=t];
 node [shape=box, style="rounded,filled", fillcolor="#EFF6FF", color="#2563EB", fontname="DejaVu Sans", fontsize=13, margin="0.16,0.10"];
 edge [color="#475569", arrowsize=0.7, fontname="DejaVu Sans", fontsize=11];

 label="Movie Finder — Data Model (ERD)\nProposed persistent entities";
 node [shape=plain];
 user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#2563EB">
 <TR><TD BGCOLOR="#DBEAFE"><B>Django User</B></TD></TR>
 <TR><TD ALIGN="LEFT">id — integer, PRIMARY KEY</TD></TR>
 <TR><TD ALIGN="LEFT">username — string, UNIQUE</TD></TR>
 <TR><TD ALIGN="LEFT">password — Django-managed hash</TD></TR>
 <TR><TD ALIGN="LEFT">is_active — boolean</TD></TR>
 <TR><TD ALIGN="LEFT">is_staff — boolean</TD></TR>
 <TR><TD ALIGN="LEFT">is_superuser — boolean</TD></TR>
 </TABLE>>];
 entry [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10" COLOR="#15803D">
 <TR><TD BGCOLOR="#DCFCE7"><B>WatchlistEntry</B></TD></TR>
 <TR><TD ALIGN="LEFT">id — integer, PRIMARY KEY</TD></TR>
 <TR><TD ALIGN="LEFT">user_id — FOREIGN KEY → User.id</TD></TR>
 <TR><TD ALIGN="LEFT">tmdb_movie_id — positive integer</TD></TR>
 <TR><TD ALIGN="LEFT">title_snapshot — string (500)</TD></TR>
 <TR><TD ALIGN="LEFT">saved_at — datetime</TD></TR>
 <TR><TD BGCOLOR="#F0FDF4">UNIQUE (user_id, tmdb_movie_id)</TD></TR>
 </TABLE>>];
 user -> entry [dir=both,arrowtail=tee,arrowhead=crow,taillabel="1",headlabel="0..many",label="owns\nEach entry belongs to exactly one user",labeldistance=2, minlen=2];
}
